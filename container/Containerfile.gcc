ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION}

ARG DEBIAN_FRONTEND=noninteractive
ARG SPACK_REF=v1.2.2
ARG GCC_VERSION=13
ARG CLANG_VERSION=""

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        gcc-${GCC_VERSION} \
        g++-${GCC_VERSION} \
        gfortran-${GCC_VERSION} \
        ca-certificates \
        cmake \
        curl \
        file \
        git \
        ninja-build \
        patch \
        pkg-config \
        python3 \
        python3-venv \
        unzip \
        xz-utils \
    && if [ -n "$CLANG_VERSION" ]; then \
        apt-get install -y --no-install-recommends clang-${CLANG_VERSION} llvm-${CLANG_VERSION}-dev; \
       fi \
    && rm -rf /var/lib/apt/lists/*

RUN git init /opt/spack \
    && git -C /opt/spack remote add origin https://github.com/spack/spack.git \
    && git -C /opt/spack fetch --depth 1 origin "$SPACK_REF" \
    && git -C /opt/spack checkout --detach FETCH_HEAD

ENV PATH="/opt/spack-agent-tools/bin:/opt/spack/bin:${PATH}" \
    SPACK_ROOT="/opt/spack" \
    SPACK_USER_CACHE_PATH="/var/cache/spack" \
    SPACK_USER_CONFIG_PATH="/opt/spack-config"

RUN python3 -m venv /opt/spack-agent-tools \
    && /opt/spack-agent-tools/bin/pip install --no-cache-dir ruff==0.16.0 \
    && mkdir -p /opt/spack-config /opt/spack-store /tmp/spack-stage /var/cache/spack \
    && printf '%s\n' \
        'config:' \
        '  install_tree:' \
        '    root: /opt/spack-store' \
        '  build_stage:' \
        '  - /tmp/spack-stage' \
        '  source_cache: /var/cache/spack/source-cache' \
        '  misc_cache: /var/cache/spack/misc-cache' \
        > /opt/spack-config/config.yaml \
    && mkdir -p /opt/spack-agent-compilers/bin \
    && ln -s /usr/bin/gcc-${GCC_VERSION} /opt/spack-agent-compilers/bin/gcc \
    && ln -s /usr/bin/g++-${GCC_VERSION} /opt/spack-agent-compilers/bin/g++ \
    && ln -s /usr/bin/gfortran-${GCC_VERSION} /opt/spack-agent-compilers/bin/gfortran \
    && if [ -n "$CLANG_VERSION" ]; then \
        ln -s /usr/bin/clang-${CLANG_VERSION} /opt/spack-agent-compilers/bin/clang; \
        ln -s /usr/bin/clang++-${CLANG_VERSION} /opt/spack-agent-compilers/bin/clang++; \
       fi \
    && spack compiler find --scope=user /opt/spack-agent-compilers/bin \
    && test -s /opt/spack-config/packages.yaml

COPY --chmod=0755 container/entrypoint.sh /usr/local/bin/spack-agent-entrypoint

WORKDIR /workspace/packages
ENTRYPOINT ["/usr/local/bin/spack-agent-entrypoint"]
CMD ["bash"]
